{
  "name": "strudel-term",
  "version": "0.1.0",
  "type": "module",
  "description": "Strudel live coding in the terminal: editor, piano roll, scope and sliders, no browser",
  "keywords": [
    "strudel",
    "livecoding",
    "tidalcycles",
    "music",
    "terminal",
    "tui",
    "sequencer"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Andrew Polyakov",
  "homepage": "https://github.com/apolyaker92/strudel-term#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apolyaker92/strudel-term.git"
  },
  "bugs": {
    "url": "https://github.com/apolyaker92/strudel-term/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "strudel-term": "src/cli.mjs"
  },
  "files": [
    "src",
    "scripts/patch-deps.mjs",
    "scripts/bounce.mjs",
    "examples",
    "README.md",
    "NOTES.md",
    "LICENSE",
    "COPYING.md"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-deps.mjs",
    "start": "node src/cli.mjs examples/first.str",
    "test": "node scripts/editor-test.mjs && node scripts/smoke.mjs",
    "bounce": "node scripts/bounce.mjs"
  },
  "dependencies": {
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@tonaljs/tonal": "^4.10.0",
    "node-web-audio-api": "^2.2.0",
    "superdough": "^1.3.0"
  }
}
