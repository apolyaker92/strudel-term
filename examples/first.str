// Type and it plays.
//
//   esc      command mode       space   play/pause
//   tab      complete           ctrl-z  undo
//   ctrl-s   save now           ctrl-g  reference

stack(
  // drums
  sound("bd ~ sn ~").gain(0.3),
  sound("hh*8").gain(0.18),

  // bass, one root per bar
  note("<a1 f1 c2 g1>")
    .struct("t ~ t ~ t ~ t ~")
    .sound("sawtooth")
    .cutoff(slider(700, 200, 4000))
    .gain(0.35),

  // melody
  note("a3 [c4 e4] d4 ~ c4 [b3 a3] e3 ~")
    .sound("triangle")
    .delay(0.3)
    .gain(0.25),
    
 //little twinkly stuff  
  note("<a4 e5 a4 a5>")
    .struct(" ~ ~ ~ ~ ~ ~ ~ ~ t")
    .sound("sin")
    .gain(0.2)
    .delay(0.6)
    
)
